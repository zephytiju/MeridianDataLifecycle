{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.dev/contracts/data-lifecycle/meridian-cache-policy.v1.schema.json",
  "title": "Meridian Cache Policy V1",
  "type": "object",
  "required": [
    "sourceResource",
    "cacheResource",
    "keyFields",
    "serializerId",
    "schemaFingerprint",
    "defaultTtlMs",
    "maximumTtlMs",
    "maximumStalenessMs",
    "negativeTtlMs",
    "sourceVersionStrategy",
    "enabled",
    "fallbackToAuthoritative",
    "maximumKeyBytes"
  ],
  "properties": {
    "sourceResource": { "type": "string", "minLength": 1 },
    "cacheResource": { "type": "string", "minLength": 1 },
    "keyFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "serializerId": { "type": "string", "minLength": 1 },
    "schemaFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "defaultTtlMs": { "type": "integer", "minimum": 1 },
    "maximumTtlMs": { "type": "integer", "minimum": 1 },
    "maximumStalenessMs": { "type": "integer", "minimum": 0 },
    "negativeTtlMs": { "type": ["integer", "null"], "minimum": 1 },
    "sourceVersionStrategy": { "enum": ["none", "exact", "at-least"] },
    "enabled": { "type": "boolean" },
    "fallbackToAuthoritative": { "type": "boolean" },
    "maximumKeyBytes": { "type": "integer", "minimum": 64 }
  },
  "additionalProperties": false
}
